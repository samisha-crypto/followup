# Copy to .env and edit.
PORT=3000
APP_NAME=FollowUp
# Public address of the site (used in emails and push links), no trailing slash
BASE_URL=https://followup.example.com
# true when served over HTTPS (recommended). Cookies are then marked Secure.
COOKIE_SECURE=true
# true when running behind a reverse proxy (Caddy / nginx / Cloudflare)
TRUST_PROXY=true
MAX_UPLOAD_MB=25
# Reminder sweep interval (minutes)
SWEEP_MINUTES=60

# --- Vercel only: Neon Postgres + private Vercel Blob + scheduled tasks ---
# DATABASE_URL=postgresql://...
# BLOB_READ_WRITE_TOKEN=...  # Or connect the Blob store to the project for OIDC.
# BLOB_STORE_ID=...          # Connected Blob store OIDC configuration.
# VERCEL_OIDC_TOKEN=...      # Injected by Vercel; do not commit or share.
# CRON_SECRET=...
# VAPID_PUBLIC=...
# VAPID_PRIVATE=...

# --- Email (optional): invitations, new-user passwords and notification emails ---
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=FollowUp <no-reply@example.com>
# EMAIL_NOTIFS=1

# --- Web push (optional): keys are generated automatically into data/vapid.json.
# VAPID_SUBJECT=mailto:admin@example.com
